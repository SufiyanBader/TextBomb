# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# macOS (Homebrew):   postgresql://postgres@localhost:5432/textbomb
# Ubuntu (default):   postgresql://postgres:yourpassword@localhost:5432/textbomb
# Windows:            postgresql://postgres:yourpassword@localhost:5432/textbomb
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/textbomb

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_char_hex_string
JWT_REFRESH_SECRET=replace_with_different_64_char_hex_string
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# ─── Encryption ───────────────────────────────────────────────────────────────
# MUST be exactly 64 hex characters (32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_64_char_hex_string_for_aes_256_gcm_encryption

# ─── Meta / WhatsApp Business API ─────────────────────────────────────────────
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=any_secret_string_you_choose
META_GRAPH_API_VERSION=v18.0

# ─── Frontend URL (for CORS) ──────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
